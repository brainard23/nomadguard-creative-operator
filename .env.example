# Vertex AI (Gemini for text/vision, Veo for video). Auth is Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Veo video provider (--provider veo). Veo needs GOOGLE_CLOUD_LOCATION=us-central1.
# Veo 3.1 default; veo-3.1-fast-generate-001 is cheaper. Preview ids: veo-3.1-generate-preview,
# veo-3.1-fast-generate-preview. The env decides, nothing is hard-coded.
VEO_MODEL=veo-3.1-generate-001
# 720p or 1080p. If Vertex rejects 1080p at 9:16, set VEO_RESOLUTION=720p. (The assembler upscales to 1080x1920 anyway; 720p is cheaper/faster)
VEO_RESOLUTION=1080p
# Parallel clip submissions (Veo bills per generated second; quotas return 429)
VEO_MAX_CONCURRENCY=2

# Set to print raw stack traces on failure
# DEBUG=1

# Creative QA (Gemini vision scoring after technical QA).
# A run is FINALIZED when the average score >= CREATIVE_QA_MIN_AVG and no score < CREATIVE_QA_MIN_SCORE
# (scores are 1-10); otherwise it ends NEEDS_REVIEW. Pass --skip-creative-qa to bypass.
# CREATIVE_QA_MIN_AVG=7
# CREATIVE_QA_MIN_SCORE=5
